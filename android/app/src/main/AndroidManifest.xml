<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Vulkan: the game renders through the Vulkan backend. Kept optional so
         the app installs everywhere and reports the missing feature in UI
         instead of being invisible on unusual devices. 0x00401000 = 1.1 -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00401000"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vulkan.compute"
        android:required="false" />

    <!-- Touchscreen support (fallback input). -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Game controller support: Bluetooth/USB gamepads are the primary input. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- External mouse input events -->
    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="false" />

    <!-- Bluetooth gamepad enumeration (Steam-style HID through SDL). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- Game content is read in place from wherever the player put it
         (selected on the picker screen, XenDroid-style). Non-media files on
         shared storage are only reachable through a real path with:
         - Android 10 (API 29): READ_EXTERNAL_STORAGE + the legacy storage flag
           (requestLegacyExternalStorage on the application element).
         - Android 11+ (API 30+): All Files Access (MANAGE_EXTERNAL_STORAGE).
         The SAF folder picker selects the folder; no copy is ever made. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Rumble support -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:largeHeap="true"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/PinyonTheme">

        <!-- Launcher: the game location picker, then the game itself. -->
        <activity
            android:name=".GamePickerActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density|colorMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PinyonActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density|colorMode">
            <!-- Let Android know we can handle some USB devices (gamepads)
                 and should receive the attach event. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>

</manifest>
