<?xml version="1.0" encoding="utf-8"?>
<!-- START GAME button, resting: Forza yellow slab with parallel slanted
     cuts on both ends. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/forza_yellow" />
        </shape>
    </item>
    <item
        android:width="12dp"
        android:gravity="start|fill_vertical"
        android:drawable="@drawable/forza_cap_dark" />
    <item
        android:width="12dp"
        android:gravity="end|fill_vertical"
        android:drawable="@drawable/forza_cap_end_dark" />
</layer-list>
