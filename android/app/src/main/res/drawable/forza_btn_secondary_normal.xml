<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary action button, resting: translucent graphite with a thin
     stroke and a dim yellow accent bar on the left edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/forza_surface" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/forza_stroke" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/forza_accent_bar" />
        </shape>
    </item>
</layer-list>
