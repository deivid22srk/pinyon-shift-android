<?xml version="1.0" encoding="utf-8"?>
<!-- Focus/press states of the secondary action buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/forza_btn_secondary_pressed" />
    <item android:state_focused="true" android:drawable="@drawable/forza_btn_secondary_focused" />
    <item android:state_selected="true" android:drawable="@drawable/forza_btn_secondary_focused" />
    <item android:state_hovered="true" android:drawable="@drawable/forza_btn_secondary_focused" />
    <item android:drawable="@drawable/forza_btn_secondary_normal" />
</selector>
