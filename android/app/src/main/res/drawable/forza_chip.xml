<?xml version="1.0" encoding="utf-8"?>
<!-- Graphics driver chip at the top of the launcher: dark slab with a
     soft cyan stroke. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/forza_chip_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/forza_cyan_soft" />
        </shape>
    </item>
</layer-list>
