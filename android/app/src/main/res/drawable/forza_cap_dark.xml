<?xml version="1.0" encoding="utf-8"?>
<!-- Diagonal cap used to slice the corners of the primary button:
     stretched to the button height it produces the parallel Forza
     slant on both ends (start cap cuts the bottom-left corner). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="12dp"
    android:height="24dp"
    android:viewportWidth="12"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/forza_background"
        android:pathData="M0,0 L12,24 L0,24 Z" />
</vector>
