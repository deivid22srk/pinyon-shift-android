<?xml version="1.0" encoding="utf-8"?>
<!--
  Forza-style logs screen.

  Landscape-first two columns:
    - left:   the recorded session list (name, date, size, file count);
    - right:  the recording settings card (toggle + level + destination)
              and the export-all action.

  View ids are consumed by LogsActivity; cutout insets are applied to
  logs_root by the activity.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/logs_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/forza_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== Header ===== -->
        <LinearLayout
            android:id="@+id/logs_title_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/ForzaTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logs_screen_title"
                android:textAllCaps="true" />

            <View
                android:layout_width="84dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/forza_title_bar" />

            <TextView
                android:id="@+id/logs_kicker"
                style="@style/ForzaKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/logs_kicker" />
        </LinearLayout>

        <!-- ===== Content ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Left column: the session list -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.35"
                android:orientation="vertical">

                <TextView
                    style="@style/ForzaKicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/logs_sessions_label" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1">

                    <ListView
                        android:id="@+id/logs_sessions_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@color/forza_stroke"
                        android:dividerHeight="1dp" />

                    <TextView
                        android:id="@+id/logs_sessions_empty"
                        style="@style/ForzaBodyDim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:text="@string/logs_sessions_empty"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Right column: recording settings + export-all -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:fadeScrollBars="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/forza_card"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/ForzaKicker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/logs_settings_label" />

                        <CheckBox
                            android:id="@+id/logs_realtime_toggle"
                            style="@style/ForzaCheckable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/logs_realtime_toggle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/rajdhani_bold"
                            android:letterSpacing="0.06"
                            android:text="@string/logs_level_label"
                            android:textAllCaps="true"
                            android:textColor="@color/forza_yellow"
                            android:textSize="13sp" />

                        <RadioGroup
                            android:id="@+id/logs_level_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="vertical">

                            <RadioButton
                                android:id="@+id/logs_level_normal"
                                style="@style/ForzaCheckable.Radio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/logs_level_normal" />

                            <RadioButton
                                android:id="@+id/logs_level_gpu"
                                style="@style/ForzaCheckable.Radio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/logs_level_gpu" />

                            <RadioButton
                                android:id="@+id/logs_level_full"
                                style="@style/ForzaCheckable.Radio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/logs_level_full" />
                        </RadioGroup>

                        <TextView
                            android:id="@+id/logs_destination"
                            style="@style/ForzaBodyDim"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/logs_export_all_button"
                        style="@style/ForzaButtonSecondary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/forza_btn_height"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/forza_btn_secondary_ripple"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:maxLines="1"
                        android:text="@string/logs_export_all_button" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
