<?xml version="1.0" encoding="utf-8"?>
<!--
  Forza-style launcher screen (game location picker).

  Landscape-first, two columns like a racing-game front end:
    - header: slanted title + kicker + driver chip;
    - left:   game location status card and the action grid
              (select / browse / driver / logs / permission);
    - right:  the big START GAME slab, driver indicator and version.

  View ids are consumed by GamePickerActivity; the cutout insets are
  applied to picker_root by the activity.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/forza_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="vertical">

        <!-- ===== Header ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/picker_title_block"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ForzaTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAllCaps="true" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="12dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/forza_chevrons" />
                </LinearLayout>

                <View
                    android:layout_width="84dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/forza_title_bar" />

                <TextView
                    style="@style/ForzaKicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/picker_subtitle" />
            </LinearLayout>

            <!-- Active graphics driver chip + REC indicator -->
            <TextView
                android:id="@+id/picker_rec_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/forza_rec_badge"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/rajdhani_bold"
                android:letterSpacing="0.18"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp"
                android:text="@string/logs_rec_badge"
                android:textColor="@color/forza_rec_red"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/picker_driver_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/forza_chip"
                android:fontFamily="@font/rajdhani_bold"
                android:letterSpacing="0.08"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="@string/picker_driver_chip_default"
                android:textAllCaps="true"
                android:textColor="@color/forza_cyan"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== Content ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Left column: status + actions -->
            <LinearLayout
                android:id="@+id/picker_left_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <!-- Game location status card -->
                <LinearLayout
                    android:id="@+id/picker_status_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/forza_card"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/picker_status_title"
                        style="@style/ForzaStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/picker_status_none" />

                    <TextView
                        android:id="@+id/picker_status_path"
                        style="@style/ForzaBodyDim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="@string/picker_status_none_hint" />

                    <TextView
                        android:id="@+id/picker_status_detail"
                        style="@style/ForzaBodyDim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:text="@string/picker_help_location" />
                </LinearLayout>

                <!-- Action grid: two buttons per row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/picker_select_button"
                        style="@style/ForzaButtonSecondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/forza_btn_height"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/forza_btn_secondary_ripple"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:maxLines="1"
                        android:nextFocusDown="@+id/picker_driver_button"
                        android:nextFocusRight="@+id/picker_browse_button"
                        android:text="@string/picker_select_button" />

                    <Button
                        android:id="@+id/picker_browse_button"
                        style="@style/ForzaButtonSecondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/forza_btn_height"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/forza_btn_secondary_ripple"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:maxLines="1"
                        android:nextFocusDown="@+id/picker_logs_button"
                        android:nextFocusLeft="@id/picker_select_button"
                        android:text="@string/picker_browse_button" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/picker_driver_button"
                        style="@style/ForzaButtonSecondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/forza_btn_height"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/forza_btn_secondary_ripple"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:maxLines="1"
                        android:nextFocusUp="@id/picker_select_button"
                        android:nextFocusRight="@+id/picker_logs_button"
                        android:text="@string/picker_gpu_driver_button" />

                    <Button
                        android:id="@+id/picker_logs_button"
                        style="@style/ForzaButtonSecondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/forza_btn_height"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/forza_btn_secondary_ripple"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:maxLines="1"
                        android:nextFocusLeft="@id/picker_driver_button"
                        android:nextFocusRight="@+id/picker_play_button"
                        android:nextFocusUp="@id/picker_browse_button"
                        android:text="@string/picker_logs_button" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/picker_gamepad_button"
                        style="@style/ForzaButtonSecondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/forza_btn_height"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/forza_btn_secondary_ripple"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:maxLines="1"
                        android:nextFocusUp="@id/picker_driver_button"
                        android:nextFocusRight="@+id/picker_play_button"
                        android:text="@string/picker_gamepad_button" />

                    <Button
                        android:id="@+id/picker_permission_button"
                        style="@style/ForzaButtonSecondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/forza_btn_height"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/forza_btn_secondary_ripple"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:maxLines="1"
                        android:text="@string/picker_permission_button"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right column: the big start slab -->
            <LinearLayout
                android:id="@+id/picker_right_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="22dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <Button
                    android:id="@+id/picker_play_button"
                    style="@style/ForzaButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/forza_start_height"
                    android:background="@drawable/forza_btn_primary_ripple"
                    android:enabled="false"
                    android:focusable="true"
                    android:nextFocusLeft="@id/picker_logs_button"
                    android:nextFocusUp="@id/picker_select_button"
                    android:text="@string/picker_play_button" />

                <TextView
                    android:id="@+id/picker_driver_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:letterSpacing="0.16"
                    android:text="@string/picker_driver_indicator_default"
                    android:textAllCaps="true"
                    android:textColor="@color/forza_cyan"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/picker_version_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.7"
                    android:fontFamily="@font/rajdhani_regular"
                    android:letterSpacing="0.14"
                    android:text="@string/picker_version_format"
                    android:textAllCaps="true"
                    android:textColor="@color/forza_text_dim"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
