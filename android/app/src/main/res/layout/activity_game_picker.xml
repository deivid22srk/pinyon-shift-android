<?xml version="1.0" encoding="utf-8"?>
<!-- Game location picker (launcher screen). Compact single column so it
     fits landscape phone screens; wrapped in a scroll view for small ones. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/picker_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/picker_accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/picker_subtitle"
            android:textColor="@color/picker_text_dim"
            android:textSize="14sp" />

        <!-- Current selection status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/picker_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/picker_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/picker_status_none"
                android:textColor="@color/picker_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/picker_status_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="@string/picker_status_none_hint"
                android:textColor="@color/picker_text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/picker_status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/picker_help_location"
                android:textColor="@color/picker_text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/picker_select_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/picker_select_button" />

        <Button
            android:id="@+id/picker_permission_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/picker_permission_button"
            android:visibility="gone" />

        <Button
            android:id="@+id/picker_browse_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@android:color/transparent"
            android:text="@string/picker_browse_button"
            android:textAllCaps="false"
            android:textColor="@color/picker_text_dim" />

        <Button
            android:id="@+id/picker_play_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:enabled="false"
            android:text="@string/picker_play_button"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
