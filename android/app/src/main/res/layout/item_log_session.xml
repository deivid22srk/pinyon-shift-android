<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the log session list: name + "date • size • files". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="9dp"
    android:paddingEnd="6dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/log_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.03"
            android:singleLine="true"
            android:textColor="@color/forza_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/log_item_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rajdhani_regular"
            android:singleLine="true"
            android:textColor="@color/forza_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="14dp"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/forza_chevrons" />
</LinearLayout>
